    "/api/runs/{run_id}/stream": {
      "get": {
        "summary": "Stream Run Events",
        "description": "SSE stream \u2014 replay DB events after `Last-Event-ID` then\nswitch to live. Uses `EventBus.stream_after` which subscribes\nFIRST (so no live event is dropped during the DB drain) and\ndedupes by id on the handoff. Heartbeat `:` comment every\n15 s; closes after `run.finished`.",
        "operationId": "stream_run_events_api_runs__run_id__stream_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
