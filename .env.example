# Copy to .env and fill in ANTHROPIC_API_KEY.
# .env is gitignored. Never commit real keys.

ANTHROPIC_API_KEY=

# LLM wiring.
# LLM_MODE=fake skips the real Anthropic client and uses FakeLLM
# (used by unit tests and the Playwright e2e). LLM_MODE=real is the demo path.
LLM_MODE=real

# Model IDs. Resolved from /v1/models in Phase 0 against the real key;
# see docs/DECISIONS.md for the full list and alternatives.
ORCHESTRATOR_MODEL=claude-sonnet-5-5
ANALYST_MODEL=claude-sonnet-5-5
ANALYST_TEXT_ONLY_MODEL=claude-haiku-5-5
PRICING_MODEL=claude-haiku-5-5

# Ingest limits (SPEC §6.1, §14).
MAX_UPLOAD_MB=20
MAX_PAGES=60
MAX_TEXT_CHARS=50000
PARSE_TIMEOUT_S=20
SINGLE_CALL_MAX_PAGES=30

# Agent timeouts and budgets (SPEC §7.3, §14).
ANALYST_TIMEOUT_S=90
PRICING_BATCH_TIMEOUT_S=45
RUN_TIMEOUT_S=240
MAX_ORCHESTRATOR_TURNS=12
RUN_TOKEN_BUDGET=400000

# Demo controls (SPEC §10.6).
DEMO_FAULTS_ENABLED=true

# Storage.
APP_DB_PATH=data/app.db
CATALOG_DB_PATH=data/catalog.db
