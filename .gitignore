.ruff_cache/

# Node
node_modules/
dist/
.vite/
frontend/dist/

# Env & secrets
.env
.env.local

# App data (seeded DBs, uploads)
backend/data/*.db
# SQLite WAL / shared-memory sidecars created when the DB is opened
# with journal_mode=WAL — same lifecycle as the .db they belong to.
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/uploads/

