              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "Meta",
        "description": "Config surface for the UI. Faults are hidden client-side when\n`demo_faults_enabled=false`; the server lists them anyway so the\nenum stays discoverable in the OpenAPI schema.",
