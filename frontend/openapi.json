    "/api/runs/{run_id}/bid": {
      "patch": {
        "summary": "Patch Run Bid",
        "description": "Atomic edit: read + check + apply + replace + audit all\nland inside ONE `db.write()` transaction via\n`repo.apply_patch_atomically`. Two concurrent PATCHes on the\nsame revision are serialised by the write lock; exactly one\nbumps the revision, the other sees `StaleRevisionConflict` and\ngets 409.",
        "operationId": "patch_run_bid_api_runs__run_id__bid_patch",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Patch Run Bid Api Runs  Run Id  Bid Patch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
